<?xml version="1.0"?>
<package format="2">
  <name>gazebo_sim_examples</name>
  <version>0.1.0</version>
  <description>Example launch orchestration for XGC2 Gazebo Classic simulation stacks.</description>

  <maintainer email="lxk@example.com">lxk</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>

  <exec_depend>gazebo_sim_fs150_sitl</exec_depend>
  <exec_depend>gazebo_sim_px4_1_12</exec_depend>
  <exec_depend>gazebo_sim_scout</exec_depend>
  <exec_depend>gazebo_sim_vrpn_bridge</exec_depend>
  <exec_depend>gazebo_sim_worlds</exec_depend>
  <exec_depend>hover_thrust_estimator</exec_depend>
  <exec_depend>multirotor_controller</exec_depend>
  <exec_depend>reference_trajectory</exec_depend>
  <exec_depend>scout_description</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>vrpn_client_ros</exec_depend>
  <exec_depend>vrpn_router</exec_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
