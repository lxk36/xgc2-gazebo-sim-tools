<?xml version="1.0"?>
<launch>
  <arg name="gui" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="verbose" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="world" default="$(find gazebo_sim_worlds)/worlds/empty/empty.world"/>
  <arg name="auto_visualization" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="rviz_config" default="$(find gazebo_sim_visualization)/rviz/gazebo_auto_visualization.rviz"/>

  <arg name="ugv_ns" default="ugv1"/>
  <arg name="ugv_model_name" default="$(arg ugv_ns)"/>
  <arg name="ugv_x" default="3.0"/>
  <arg name="ugv_y" default="0.0"/>
  <arg name="ugv_z" default="0.181"/>
  <arg name="ugv_yaw" default="0.0"/>
  <arg name="ugv_wheel_contact_mu2" default="0.10"/>
  <arg name="ugv_wheel_contact_slip2" default="5.0"/>
  <arg name="ugv_wheel_pid_p" default="10.0"/>
  <arg name="ugv_wheel_pid_i" default="0.0"/>
  <arg name="ugv_wheel_pid_d" default="0.0"/>
  <arg name="ugv_wheel_separation" default="0.416503"/>
  <arg name="ugv_wheel_radius" default="0.08"/>
  <arg name="ugv_command_gain" default="1.10"/>
  <arg name="ugv_angular_command_gain" default="0.80"/>

  <arg name="vrpn_server" default="127.0.0.1"/>
  <arg name="vrpn_port" default="3883"/>
  <arg name="vrpn_config_file" default="$(find gazebo_sim_vrpn_bridge)/config/vrpn_server.yaml"/>
  <arg name="vrpn_tracker" default="$(arg ugv_model_name)"/>
  <arg name="vrpn_frame_id" default="map"/>
  <arg name="vrpn_update_frequency" default="100.0"/>
  <arg name="vrpn_use_server_time" default="false"/>
  <arg name="vrpn_broadcast_tf" default="false"/>
  <arg name="vrpn_publish_rate" default="120.0"/>
  <arg name="vrpn_match_mode" default="exact"/>

  <arg name="estimator_config_file" default="$(find estimator_vrpn_ugv_state)/config/vrpn_ugv_state_estimator.yaml"/>
  <arg name="estimator_imu_topic" default="/$(arg ugv_ns)/imu"/>
  <arg name="estimator_vrpn_pose_topic" default="/vrpn_client_node/$(arg vrpn_tracker)/pose"/>
  <arg name="estimator_state_topic" default="alg/state_estimator/state"/>
  <arg name="estimator_loop_rate_hz" default="1000.0"/>
  <arg name="estimator_state_publish_rate_hz" default="100.0"/>
  <arg name="estimator_imu_timeout_s" default="0.2"/>
  <arg name="estimator_vrpn_timeout_s" default="0.12"/>
  <arg name="estimator_coasting_timeout_s" default="0.5"/>
  <arg name="estimator_min_imu_rate_hz" default="5.0"/>
  <arg name="estimator_min_vrpn_rate_hz" default="20.0"/>
  <arg name="estimator_extrinsic_verified" default="true"/>

  <arg name="reference_config_file" default="$(find unicycle_reference_trajectory)/config/unicycle_reference_trajectory.yaml"/>
  <arg name="reference_main_frequency" default="100.0"/>
  <arg name="reference_status_rate" default="10.0"/>
  <arg name="reference_active_publish_rate" default="20.0"/>
  <arg name="reference_trajectory_timeout" default="0.5"/>
  <arg name="reference_min_lead_time" default="0.2"/>
  <arg name="reference_max_velocity" default="3.0"/>
  <arg name="reference_max_acceleration" default="2.0"/>
  <arg name="reference_max_yaw_rate" default="2.5"/>
  <arg name="reference_default_enabled" default="true"/>
  <arg name="reference_default_type" default="3"/>
  <arg name="reference_default_duration" default="120.0"/>
  <arg name="reference_default_start_delay" default="0.8"/>
  <arg name="reference_default_origin_x" default="$(arg ugv_x)"/>
  <arg name="reference_default_origin_y" default="$(arg ugv_y)"/>
  <arg name="reference_default_origin_yaw" default="$(arg ugv_yaw)"/>
  <arg name="reference_default_radius" default="3.0"/>
  <arg name="reference_default_line_speed" default="1.0"/>
  <arg name="reference_default_entry_duration" default="3.0"/>
  <arg name="reference_default_center_x" default="0.0"/>
  <arg name="reference_default_center_y" default="0.0"/>

  <arg name="target_replanner_enabled" default="false"/>
  <arg name="target_replanner_config_file" default="$(find unicycle_reference_trajectory)/config/unicycle_target_replanner.yaml"/>
  <arg name="target_replanner_period" default="5.0"/>
  <arg name="target_replanner_desired_speed" default="1.0"/>
  <arg name="target_replanner_max_velocity" default="$(arg reference_max_velocity)"/>
  <arg name="target_replanner_max_acceleration" default="$(arg reference_max_acceleration)"/>
  <arg name="target_replanner_max_yaw_rate" default="$(arg reference_max_yaw_rate)"/>
  <arg name="target_replanner_random_targets" default="true"/>
  <arg name="target_replanner_random_min_x" default="-5.0"/>
  <arg name="target_replanner_random_max_x" default="5.0"/>
  <arg name="target_replanner_random_min_y" default="-5.0"/>
  <arg name="target_replanner_random_max_y" default="5.0"/>
  <arg name="target_replanner_random_yaw_mode" default="heading"/>
  <arg name="target_replanner_random_seed" default="0"/>

  <arg name="controller_config_file" default="$(find unicycle_ugv_controller)/config/unicycle_ugv_controller.yaml"/>
  <arg name="controller_rate_hz" default="100.0"/>
  <arg name="controller_state_timeout" default="0.2"/>
  <arg name="controller_reference_timeout" default="0.5"/>
  <arg name="controller_command_publish_rate_hz" default="100.0"/>
  <arg name="controller_auto_start_tracking" default="true"/>
  <arg name="controller_nmpc_control_period" default="0.1"/>
  <arg name="controller_nmpc_prediction_horizon" default="1.0"/>
  <arg name="controller_nmpc_request_rate_hz" default="100.0"/>
  <arg name="controller_nmpc_solve_timeout" default="0.05"/>
  <arg name="controller_nmpc_result_timeout" default="0.1"/>
  <arg name="controller_min_linear_speed" default="-0.5"/>
  <arg name="controller_max_linear_speed" default="3.0"/>
  <arg name="controller_max_angular_speed" default="2.5"/>
  <arg name="controller_max_linear_acceleration" default="2.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="verbose" value="$(arg verbose)"/>
  </include>

  <include file="$(find gazebo_sim_scout)/launch/spawn_accurate.launch">
    <arg name="ns" value="$(arg ugv_ns)"/>
    <arg name="model_name" value="$(arg ugv_model_name)"/>
    <arg name="x" value="$(arg ugv_x)"/>
    <arg name="y" value="$(arg ugv_y)"/>
    <arg name="z" value="$(arg ugv_z)"/>
    <arg name="yaw" value="$(arg ugv_yaw)"/>
    <arg name="sensor_ns" value="/$(arg ugv_ns)"/>
    <arg name="wheel_contact_mu2" value="$(arg ugv_wheel_contact_mu2)"/>
    <arg name="wheel_contact_slip2" value="$(arg ugv_wheel_contact_slip2)"/>
    <arg name="wheel_pid_p" value="$(arg ugv_wheel_pid_p)"/>
    <arg name="wheel_pid_i" value="$(arg ugv_wheel_pid_i)"/>
    <arg name="wheel_pid_d" value="$(arg ugv_wheel_pid_d)"/>
    <arg name="wheel_separation" value="$(arg ugv_wheel_separation)"/>
    <arg name="wheel_radius" value="$(arg ugv_wheel_radius)"/>
    <arg name="command_gain" value="$(arg ugv_command_gain)"/>
    <arg name="angular_command_gain" value="$(arg ugv_angular_command_gain)"/>
  </include>

  <include file="$(find gazebo_sim_vrpn_bridge)/launch/vrpn_server.launch">
    <arg name="config" value="$(arg vrpn_config_file)"/>
    <arg name="port" value="$(arg vrpn_port)"/>
    <arg name="publish_rate" value="$(arg vrpn_publish_rate)"/>
    <arg name="trackers" value="$(arg vrpn_tracker)"/>
    <arg name="match_mode" value="$(arg vrpn_match_mode)"/>
    <arg name="auto_track_known_models" value="false"/>
  </include>

  <include file="$(find gazebo_sim_vrpn_bridge)/launch/vrpn_client.launch">
    <arg name="server" value="$(arg vrpn_server)"/>
    <arg name="port" value="$(arg vrpn_port)"/>
    <arg name="trackers" value="[$(arg vrpn_tracker)]"/>
    <arg name="update_frequency" value="$(arg vrpn_update_frequency)"/>
    <arg name="frame_id" value="$(arg vrpn_frame_id)"/>
    <arg name="use_server_time" value="$(arg vrpn_use_server_time)"/>
    <arg name="broadcast_tf" value="$(arg vrpn_broadcast_tf)"/>
  </include>

  <group ns="$(arg ugv_ns)">
    <node pkg="estimator_vrpn_ugv_state"
          type="vrpn_ugv_state_estimator_node"
          name="vrpn_ugv_state_estimator"
          output="screen"
          clear_params="true">
      <rosparam command="load" file="$(arg estimator_config_file)"/>
      <param name="imu_topic" value="$(arg estimator_imu_topic)"/>
      <param name="vrpn_pose_topic" value="$(arg estimator_vrpn_pose_topic)"/>
      <param name="state_topic" value="$(arg estimator_state_topic)"/>
      <param name="loop_rate_hz" value="$(arg estimator_loop_rate_hz)"/>
      <param name="state_publish_rate_hz" value="$(arg estimator_state_publish_rate_hz)"/>
      <param name="imu_timeout_s" value="$(arg estimator_imu_timeout_s)"/>
      <param name="vrpn_timeout_s" value="$(arg estimator_vrpn_timeout_s)"/>
      <param name="coasting_timeout_s" value="$(arg estimator_coasting_timeout_s)"/>
      <param name="min_imu_rate_hz" value="$(arg estimator_min_imu_rate_hz)"/>
      <param name="min_vrpn_rate_hz" value="$(arg estimator_min_vrpn_rate_hz)"/>
      <param name="extrinsic_verified" value="$(arg estimator_extrinsic_verified)"/>
    </node>
  </group>

  <include file="$(find unicycle_reference_trajectory)/launch/ugv_unicycle_reference_trajectory.launch">
    <arg name="ns" value="$(arg ugv_ns)"/>
    <arg name="config_file" value="$(arg reference_config_file)"/>
    <arg name="main_frequency" value="$(arg reference_main_frequency)"/>
    <arg name="status_rate" value="$(arg reference_status_rate)"/>
    <arg name="active_publish_rate" value="$(arg reference_active_publish_rate)"/>
    <arg name="trajectory_timeout" value="$(arg reference_trajectory_timeout)"/>
    <arg name="min_lead_time" value="$(arg reference_min_lead_time)"/>
    <arg name="max_velocity" value="$(arg reference_max_velocity)"/>
    <arg name="max_acceleration" value="$(arg reference_max_acceleration)"/>
    <arg name="max_yaw_rate" value="$(arg reference_max_yaw_rate)"/>
    <arg name="default_analytic_enabled" value="$(arg reference_default_enabled)"/>
    <arg name="default_analytic_type" value="$(arg reference_default_type)"/>
    <arg name="default_analytic_duration" value="$(arg reference_default_duration)"/>
    <arg name="default_analytic_start_delay" value="$(arg reference_default_start_delay)"/>
    <arg name="default_analytic_origin_x" value="$(arg reference_default_origin_x)"/>
    <arg name="default_analytic_origin_y" value="$(arg reference_default_origin_y)"/>
    <arg name="default_analytic_origin_yaw" value="$(arg reference_default_origin_yaw)"/>
    <arg name="default_analytic_radius" value="$(arg reference_default_radius)"/>
    <arg name="default_analytic_line_speed" value="$(arg reference_default_line_speed)"/>
    <arg name="default_analytic_entry_duration" value="$(arg reference_default_entry_duration)"/>
    <arg name="default_analytic_center_x" value="$(arg reference_default_center_x)"/>
    <arg name="default_analytic_center_y" value="$(arg reference_default_center_y)"/>
  </include>

  <include if="$(arg target_replanner_enabled)"
           file="$(find unicycle_reference_trajectory)/launch/ugv_unicycle_target_replanner.launch">
    <arg name="ns" value="$(arg ugv_ns)"/>
    <arg name="config_file" value="$(arg target_replanner_config_file)"/>
    <arg name="replan_period" value="$(arg target_replanner_period)"/>
    <arg name="desired_speed" value="$(arg target_replanner_desired_speed)"/>
    <arg name="max_velocity" value="$(arg target_replanner_max_velocity)"/>
    <arg name="max_acceleration" value="$(arg target_replanner_max_acceleration)"/>
    <arg name="max_yaw_rate" value="$(arg target_replanner_max_yaw_rate)"/>
    <arg name="random_targets" value="$(arg target_replanner_random_targets)"/>
    <arg name="random_min_x" value="$(arg target_replanner_random_min_x)"/>
    <arg name="random_max_x" value="$(arg target_replanner_random_max_x)"/>
    <arg name="random_min_y" value="$(arg target_replanner_random_min_y)"/>
    <arg name="random_max_y" value="$(arg target_replanner_random_max_y)"/>
    <arg name="random_yaw_mode" value="$(arg target_replanner_random_yaw_mode)"/>
    <arg name="random_seed" value="$(arg target_replanner_random_seed)"/>
  </include>

  <include file="$(find unicycle_ugv_controller)/launch/ugv_unicycle_nmpc_controller.launch">
    <arg name="ns" value="$(arg ugv_ns)"/>
    <arg name="config_file" value="$(arg controller_config_file)"/>
    <arg name="control_rate_hz" value="$(arg controller_rate_hz)"/>
    <arg name="state_timeout" value="$(arg controller_state_timeout)"/>
    <arg name="reference_timeout" value="$(arg controller_reference_timeout)"/>
    <arg name="command_publish_rate_hz" value="$(arg controller_command_publish_rate_hz)"/>
    <arg name="auto_start_tracking" value="$(arg controller_auto_start_tracking)"/>
    <arg name="nmpc_control_period" value="$(arg controller_nmpc_control_period)"/>
    <arg name="nmpc_prediction_horizon" value="$(arg controller_nmpc_prediction_horizon)"/>
    <arg name="nmpc_request_rate_hz" value="$(arg controller_nmpc_request_rate_hz)"/>
    <arg name="nmpc_solve_timeout" value="$(arg controller_nmpc_solve_timeout)"/>
    <arg name="nmpc_result_timeout" value="$(arg controller_nmpc_result_timeout)"/>
    <arg name="min_linear_speed" value="$(arg controller_min_linear_speed)"/>
    <arg name="max_linear_speed" value="$(arg controller_max_linear_speed)"/>
    <arg name="max_angular_speed" value="$(arg controller_max_angular_speed)"/>
    <arg name="max_linear_acceleration" value="$(arg controller_max_linear_acceleration)"/>
  </include>

  <include if="$(arg auto_visualization)"
           file="$(find gazebo_sim_visualization)/launch/gazebo_auto_visualization_rviz.launch">
    <arg name="frame_id" value="world"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
  </include>
</launch>
