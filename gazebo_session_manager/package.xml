<?xml version="1.0"?>
<package format="2">
  <name>gazebo_session_manager</name>
  <version>0.0.1</version>
  <description>Web-based process and model controls for Gazebo Classic sessions.</description>

  <maintainer email="lxk@example.com">lxk</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gazebo_sim_vrpn_bridge</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>vrpn_client_ros</exec_depend>

  <export/>
</package>
