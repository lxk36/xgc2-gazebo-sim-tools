<?xml version="1.0"?>
<package format="2">
  <name>gazebo_sim_visualization</name>
  <version>0.1.0</version>
  <description>RViz visualization tools for XGC2 Gazebo simulations.</description>

  <maintainer email="lxk@example.com">lxk</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roslaunch</build_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>gazebo_sim_fs150_sitl</exec_depend>
  <exec_depend>multirotor_reference_trajectory</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>roslaunch</test_depend>

  <export/>
</package>
